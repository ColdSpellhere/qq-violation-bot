[Unit]
Description=NapCat QQ instance %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=root
Environment=QQ_BOTS_ROOT=/opt/qq-bots
Environment=NAPCAT_INSTALL_ROOT=/root/Napcat
EnvironmentFile=/opt/qq-bots/instances/%i/.env
ExecStart=/opt/qq-bots/instances/%i/current/scripts/start_napcat.sh %i
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
